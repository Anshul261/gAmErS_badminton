{
  "name": "courtside",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop --project-id gAmErS_badminton",
    "db:test": "docker exec -i supabase_db_gAmErS_badminton psql -U postgres -d postgres -X -v ON_ERROR_STOP=1 < supabase/tests/security.sql",
    "db:test:concurrency": "node scripts/test-concurrency.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "geist": "1.7.2",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.1"
  }
}
